# Odoo-oriented tuning and WAL archiving.
listen_addresses = '*'
password_encryption = 'scram-sha-256'

wal_level = replica
archive_mode = on
# PostgreSQL does not expand environment variables in this file, so the
# stanza name must be a literal. Each tenant runs its own Postgres, so a
# fixed stanza is unambiguous and removes a whole class of templating bug.
archive_command = 'pgbackrest --stanza=main archive-push %p'
archive_timeout = 300

max_connections = 100
shared_buffers = 512MB
effective_cache_size = 1536MB
work_mem = 16MB
maintenance_work_mem = 128MB

# Odoo writes many small rows; a larger WAL reduces checkpoint churn.
max_wal_size = 2GB
min_wal_size = 256MB
checkpoint_completion_target = 0.9

log_min_duration_statement = 1000
log_checkpoints = on
log_lock_waits = on
log_line_prefix = '%m [%p] %q%u@%d '
